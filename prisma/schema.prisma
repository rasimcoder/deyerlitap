generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String     @id @default(cuid())
  title       String
  description String?
  price       Float
  oldPrice    Float?
  image       String
  images      String[]
  condition   String
  stock       Int        @default(1)
  isFeatured  Boolean    @default(false)
  isActive    Boolean    @default(true)
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  costPrice   Float    @default(0)
}

model Order {
  id         String      @id @default(cuid())
  fullName   String
  phone      String
  city       String
  address    String
  note       String?
  total      Float
  status     String      @default("pending")
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  price     Float
  quantity  Int
  image     String
  costPrice   Float    @default(0)
}